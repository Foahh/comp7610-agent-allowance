{
  "name": "@repo/agent-allowance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter ./apps/* dev",
    "build": "vp run -r build",
    "check": "vp check",
    "ready": "vp check && vp run -r build",
    "db:generate": "vp run @repo/db#db:generate",
    "db:migrate": "vp exec node scripts/migrate.ts",
    "prepare": "vp config",
    "doctor": "vp exec react-doctor",
    "test:contracts": "vp run @repo/contracts#test",
    "chain": "vp run @repo/contracts#node",
    "deploy:local": "vp run @repo/contracts#deploy:local",
    "models:check": "vp exec node scripts/check-models.ts",
    "deploy:sepolia": "vp run @repo/contracts#deploy:sepolia"
  },
  "devDependencies": {
    "@repo/db": "workspace:*",
    "@repo/utils": "workspace:*",
    "@types/node": "catalog:",
    "react-doctor": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.3.4"
}
