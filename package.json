{
  "name": "@repo/agent-spend-guard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "knip": "knip",
    "deps:check": "knip --dependencies",
    "dev": "vp run --parallel --filter ./apps/* dev",
    "build": "vp run -r build",
    "check": "vp check",
    "ready": "vp check && vp run -r build",
    "db:init": "vp exec node scripts/init-db.ts",
    "prepare": "vp config",
    "doctor": "vp exec react-doctor",
    "accounts": "vp exec node scripts/accounts.ts",
    "models:check": "vp exec node scripts/check-models.ts",
    "deploy:sepolia": "vp run @repo/contracts#deploy:sepolia",
    "test:contracts": "vp test packages/contracts/test"
  },
  "devDependencies": {
    "@repo/db": "workspace:*",
    "@repo/utils": "workspace:*",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "react-doctor": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.3.4"
}
