# Live model credentials are required for chat and specialist work.
# Optional Sepolia RPC override; defaults to the public endpoint below.
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
API_PORT=3001
PROVIDERS_PORT=3002
APP_ORIGIN=http://127.0.0.1:3000
PROVIDER_URL=http://127.0.0.1:3002

# Deployment commands populate data/deployment-<chainId>.json.
# TOKEN_ADDRESS=
# VAULT_ADDRESS=
# PROVIDER_ADDRESS=
# DATABASE_PATH=
# PROVIDER_DATABASE_PATH=

# Configure a Chat Completions endpoint supporting streaming, tools, and structured output.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
