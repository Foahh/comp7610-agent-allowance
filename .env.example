# Optional local-service overrides.
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
API_PORT=3001
PROVIDERS_PORT=3002
APP_ORIGIN=http://localhost:3000
PROVIDER_URL=http://localhost:3002

# Optional deployment overrides.
# TOKEN_ADDRESS=
# VAULT_ADDRESS=
# PROVIDER_ADDRESS=

# Optional database file locations.
# DATABASE_PATH=
# PROVIDER_DATABASE_PATH=

# Required.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional.
# BUYER_BASE_URL=
# BUYER_API_KEY=
# BUYER_MODEL=
# SELLER_BASE_URL=
# SELLER_API_KEY=
# SELLER_MODEL=

# Required identities.
# Never use funded mainnet keys.
# DEPLOYER_PRIVATE_KEY can be same as AGENT_PRIVATE_KEY for testing purposes.
# DEPLOYER_PRIVATE_KEY=
# AGENT_PRIVATE_KEY=
# PROVIDER_PRIVATE_KEY=
